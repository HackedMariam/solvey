# ==============================================================================
# Escalation & Jira Ticket-Creation Workflow Configuration
# Copy this file to .env and fill in your values when ready:
#   cp .env.example .env
# ==============================================================================

# Ticketing Mode: "mock" (default, safe for local testing) or "jira" (real API calls)
TICKETING_MODE=mock

# ------------------------------------------------------------------------------
# LLM Configuration
# ------------------------------------------------------------------------------
# Provider: "mock", "openai", "gemini", or "custom"
# - "mock": Fast deterministic synthesis without external API calls
# - "openai": Uses OpenAI API (e.g. gpt-4o-mini)
# - "gemini": Uses Gemini via Google's OpenAI-compatible endpoint
# - "custom": Any OpenAI-compatible endpoint (Ollama, Groq, LocalAI, vLLM)
LLM_PROVIDER=mock

# Model identifier
# Examples:
#   OpenAI: gpt-4o-mini, gpt-4o
#   Gemini: gemini-2.5-flash, gemini-1.5-flash
LLM_MODEL=gpt-4o-mini

# API key for the chosen LLM provider (Leave empty if using mock)
LLM_API_KEY=

# Base URL (Optional: needed for Gemini OpenAI-endpoint, Ollama, Groq, etc.)
# Examples:
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama: http://localhost:11434/v1
#   Groq:   https://api.groq.com/openai/v1
LLM_BASE_URL=

# Timeout in seconds for LLM API calls
LLM_TIMEOUT_SECONDS=30

# If true, falls back to deterministic factual synthesis if the LLM fails
LLM_FALLBACK_ON_FAILURE=true

# ------------------------------------------------------------------------------
# Jira Cloud Configuration (Required only when TICKETING_MODE=jira)
# ------------------------------------------------------------------------------
# Base URL of your Atlassian Jira Cloud instance (no trailing slash)
# Example: https://your-organization.atlassian.net
JIRA_BASE_URL=

# Email address associated with your Jira Cloud account
JIRA_EMAIL=

# Jira API Token generated at https://id.atlassian.com/manage-profile/security/api-tokens
# NEVER commit your real token to source control
JIRA_API_TOKEN=

# Jira Project Key where issues should be created (e.g., "IT", "SUP", "KAN")
JIRA_PROJECT_KEY=

# Jira Issue Type (e.g., "Task", "Bug", "Incident", or "IT Help")
JIRA_ISSUE_TYPE=Task

# Jira REST API version (3 is standard for Jira Cloud with Atlassian Document Format)
JIRA_API_VERSION=3

# Jira request timeout in seconds
JIRA_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# Service & Server Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
DEBUG=false
