    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $('Execute Workflow Trigger').first().json;\nconst filtered = $('Qdrant Search (category)').first().json;\nconst fallbackWasUsed = Boolean(input.category) && (((filtered.result || {}).points || []).length < 2);\nconst response = fallbackWasUsed\n  ? $('Qdrant Search (fallback)').first().json\n  : filtered;\nconst points = ((response.result || {}).points || []).slice(0, 5);\nconst chunks = points.map((point, index) => {\n  const payload = point.payload || {};\n  return {\n    id: `S${index + 1}`,\n    text: payload.text || '',\n    table_raw: payload.table_raw || null,\n    title: payload.title || '',\n    section: payload.section || '',\n    page: payload.page ?? null,\n    source: payload.source || '',\n    url: payload.url || null,\n    category: payload.category || 'general',\n    score: point.score\n  };\n});\nreturn [{ json: { chunks, used_filter: Boolean(input.category) && !fallbackWasUsed } }];"
      },
