# Production URL of the n8n "Main workflow" webhook (the workflow must be published/active).
N8N_WEBHOOK_URL=https://solvey.app.n8n.cloud/webhook/solvey/main

# Optional shared secret, sent to n8n as the header X-Solvey-Secret.
# Only protects the webhook once the n8n "Receive Ticket" node is set to check this header.
N8N_WEBHOOK_SECRET=
